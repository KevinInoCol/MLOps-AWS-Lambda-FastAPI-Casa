# URL base del backend, SIN "/" al final. Se inyecta en BUILD time (npm run build).
# NO es un secreto: queda visible en el JavaScript del navegador.
# Local:   http://localhost:8000
# Lambda:  https://<id>.lambda-url.<region>.on.aws
VITE_API_URL=http://localhost:8000

# Opcionales (valores por defecto de la API de precio de casas)
VITE_RUTA_PREDICCION=/obtener-datos-de-usuario-y-predecir
VITE_COLUMNA_PREDICCION=Predicciones_Sin_Escalar
